          "type": "string"
        },
        "sampling_probability": {
          "default": 1.0,
          "exclusiveMinimum": 0,
          "maximum": 1,
          "title": "Sampling Probability",
          "type": "number"
        },
        "selection_rule": {
          "default": "full",
          "title": "Selection Rule",
          "type": "string"
        }
      },
      "title": "Capture",
      "type": "object"
    },
    "Completion": {
