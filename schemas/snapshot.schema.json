        "policy_version": {
          "title": "Policy Version",
          "type": "string"
        },
        "old_policy_version": {
          "title": "Old Policy Version",
          "type": "string"
        },
        "reference_policy_version": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Reference Policy Version"
        },
        "loss_type": {
          "default": "dapo",
          "enum": [
            "grpo",
            "dapo",
            "dr_grpo",
            "bnpo"
          ],
