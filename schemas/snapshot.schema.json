        "epsilon_high": {
          "default": 0.2,
          "minimum": 0,
          "title": "Epsilon High",
          "type": "number"
        },
        "kl_coefficient": {
          "default": 0,
          "minimum": 0,
          "title": "Kl Coefficient",
          "type": "number"
        },
        "num_processes": {
          "default": 1,
          "minimum": 1,
          "title": "Num Processes",
          "type": "integer"
        },
        "gradient_accumulation_steps": {
          "default": 1,
          "minimum": 1,
          "title": "Gradient Accumulation Steps",
          "type": "integer"
        },
        "global_effective_tokens": {
          "minimum": 0,
          "title": "Global Effective Tokens",
          "type": "integer"
        },
        "max_completion_length": {
          "minimum": 1,
          "title": "Max Completion Length",
          "type": "integer"
        },
        "source": {
          "minLength": 1,
          "title": "Source",
          "type": "string"
        },
        "source_loss": {
          "anyOf": [
            {
              "type": "number"
