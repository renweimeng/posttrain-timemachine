    "ObjectiveBatch": {
      "additionalProperties": false,
      "properties": {
        "objective_id": {
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$",
          "title": "Objective Id",
          "type": "string"
